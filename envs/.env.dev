# API SETTINGS
ENVIRONMENT=dev
NO_API_WORKERS=2
API_WORKERS_TIMEOUT=60
APP_NAME="Yumlytics"
APP_RUN_NAME="main:app"
HOST=0.0.0.0
API_PORT=8000
ORIGINS=["http://0.0.0.0","http://0.0.0.0:8000","http://0.0.0.0:8001"]
LOG_LEVEL=INFO  # DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_DIR="/home/non-root/app/src/log"

# CELERY
CELERY_WORKERS=4
CELERY_NAME="video_processor"
RETURN_MOCK_PARSED_SCHEMA=True

# FLOWER
FLOWER_USER="flower"
FLOWER_PASSWORD="flower"
FLOWER_PORT=5555
FLOWER_SERVICE=flower

# REDIS
REDIS_PORT=6379
REDIS_SERVICE=redis

# NGINX
NGINX_HTTP_PORT=80